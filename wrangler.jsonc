{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paste-cloudflare",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "upload_source_maps": true,
  "routes": [{ "pattern": "paste.modrinth.com", "custom_domain": true }],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "placement": { "mode": "smart" },
  // Built from the paste submodule by `pnpm run build:paste`
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "cache": { "enabled": true },
  // The default export restores the client's Accept-Encoding and stays uncached so CachedApp can Vary on it.
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "CachedApp": { "type": "worker", "cache": { "enabled": true } },
  },
  "kv_namespaces": [
    { "binding": "INDEX", "id": "292bb9d30c914bb5a5d7254da9f28bcc" },
  ],
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "bytebin" }],
  // Limits are approximate and counted per Cloudflare location. Periods can only be 10 or 60 seconds.
  "ratelimits": [
    // upstream default: 30 per 10 minutes
    {
      "name": "POST_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 15, "period": 60 },
    },
    // upstream default: 30 per 5 minutes
    {
      "name": "PUT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 6, "period": 60 },
    },
    // upstream default: 30 per 2 minutes
    {
      "name": "GET_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "vars": {
    "KEY_LENGTH": 7,
    "MAX_CONTENT_LENGTH_MB": 10,
    "ALLOW_MODIFICATION": true,
    // 90 days. 0 means never expire
    "DEFAULT_LIFETIME_MINUTES": 129600,
    // Matched against User-Agent, then Origin, then Host. Every distinct lifetime needs an R2 lifecycle rule (see README).
    "LIFETIME_OVERRIDES_MINUTES": {},
    "HOST_ALIASES": {},
  },
}
